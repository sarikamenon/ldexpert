APP_ENV=testing
APP_DEBUG=true
# Chrome runs INSIDE the app container during Dusk, so the base URL must be the
# in-network nginx host, not the host-published localhost:8080 (unreachable from
# inside the container → net::ERR_CONNECTION_REFUSED).
APP_URL=http://nginx

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bird_test
DB_USERNAME=bird
DB_PASSWORD=secret

CACHE_STORE=array
# Dusk needs a persistent session store (separate FPM process per request);
# 'array' loses auth between loginAs() and the next request. Use 'file'.
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=array
FILESYSTEM_DISK=s3

# Telescope must NOT run during tests: its table lives on a different connection
# than bird_test, so it throws "telescope_entries doesn't exist" on every request.
TELESCOPE_ENABLED=false

# Sentry Configuration (disabled for testing)
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=testing
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

