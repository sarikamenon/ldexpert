APP_ENV=testing
APP_DEBUG=true
APP_URL=http://nginx

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bird_test
DB_USERNAME=bird
DB_PASSWORD=secret

CACHE_STORE=array
# Dusk makes each HTTP request in a separate FPM process, so the session must
# persist server-side. The 'array' driver only lives for one process, so
# loginAs() never carries across to the next request → every protected page
# redirects to /login. Use 'file' so auth survives across Dusk requests.
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=array
FILESYSTEM_DISK=s3

# Telescope must NOT run during tests: its table lives on a different connection
# than bird_test, so it throws "telescope_entries doesn't exist" on every request.
TELESCOPE_ENABLED=false

# Sentry Configuration (disabled for testing)
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=testing
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

APP_KEY=base64:ERHg+rALBfT0JOml7ptDjvweHLmfbfYOgj8CUMhohYw=
